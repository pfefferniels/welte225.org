            },
            "keeper": {
                "name": "Nigel Nettheim",
                "sameAs": [
                    "https://d-nb.info/gnd/1047657759",
                    "http://www.wikidata.org/entity/Q139198104",
                    "https://nettheim.com/"
                ],
                "@annotation": {
                    "belief": {
                        "certainty": "true",
                        "reasons": [
                            {
                                "actor": {
                                    "name": "Phillips, Peter",
                                    "sameAs": []
                                },
                                "note": "Die Rolle gehört Nigel Nettheim. Das sagt Peter Phillips, der sie gelesen hat (Mail, 20.9.2026); er fügt an, Nettheim länger nicht gesehen zu haben, so dass offenbleibt, ob sie noch dort liegt.",
                                "@type": "beliefAdoption"
                            },
                            {
                                "actor": {
                                    "name": "Nettheim, Nigel",
                                    "sameAs": [
                                        "https://d-nb.info/gnd/1047657759",
                                        "http://www.wikidata.org/entity/Q139198104"
                                    ]
                                },
                                "note": "Nettheim schreibt, die Rolle liege weiterhin bei ihm: „I still have the roll Welte 225 (DeLuxe, price $2.00)“ (Mail, 21.9.2026). Damit ist die Frage beantwortet, die Phillips offenließ.",
                                "@type": "beliefAdoption"
                            }
                        ],
                        "@type": "belief",
                        "@id": "698488c3-678e-469b-b024-a370e59ad6a2"
                    },
                    "@id": "b6eda586-901a-46f9-ba8d-ea5a44c86011"
                }
            },
            "production": {
                "date": {
                    "after": "1916-01-01",
                    "@annotation": {
                        "belief": {
                            "certainty": "true",
                            "reasons": [
                                {
                                    "actor": {
                                        "name": "Phillips, Peter",
                                        "sameAs": []
                                    },
                                    "note": "Das Werk in Poughkeepsie räumte der Auto Pneumatic Action Company 1916 die Rechte an den Welte-Mignon-Patenten ein, um das Licensee-Instrument zu entwickeln. Die Rollen dafür entstanden von da an in Poughkeepsie aus den vorhandenen Welte-Mignon-Matrizen (Phillips 2016, S. 19 f.).",
                                    "@type": "beliefAdoption"
                                },
                                {
                                    "note": "Eine Licensee-Umstanzung kann nicht älter sein als die Rechte, aus denen sie hervorgeht. Die untere Grenze ist damit das Jahr 1916.",
                                    "premises": [],
                                    "applies": [
                                        "rules#system-terminus"
                                    ],
                                    "@type": "inference"
                                },
                                {
                                    "actor": {
                                        "name": "Phillips, Peter",
                                        "sameAs": []
                                    },
                                    "note": "Auf der Rolle steht nichts, weder ein Stanzdatum noch ein sonstiger Vermerk (Mail, 20.9.2026). Zur Datierung trägt das Exemplar selbst damit nichts bei.",
                                    "@type": "beliefAdoption"
                                }
                            ],
