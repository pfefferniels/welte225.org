                                "from": 121.841691,
                                "to": 179.768945
                            },
                            "@type": "HoleChain",
                            "@id": "e9b1cf87-5145-4ded-8c0d-ec5809ad9032"
                        }
                    ],
                    "@type": "Alteration"
                }
            ],
