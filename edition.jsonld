            "production": {
                "date": {
                    "after": "1924-01-01",
                    "@annotation": {
                        "belief": {
                            "certainty": "likely",
                            "reasons": [
                                {
                                    "actor": {
                                        "name": "Hagmann, Peter",
                                        "sameAs": [
                                            "https://d-nb.info/gnd/1036333507",
                                            "http://www.wikidata.org/entity/Q95314399"
                                        ]
                                    },
                                    "note": "Zur Leipziger Herbstmesse 1924 brachte Welte das Mignola und das Welte heraus, beide mit der jüngeren Blockskala T-98, und verkaufte das Welte-Mignon mit dieser Skala vom selben Jahr an (Hagmann 1984, S. 42 f. und S. 117, Anm. 15). Für diese Skala gelten die grünen Rollen (ebd., S. 89).",
                                    "@type": "beliefAdoption"
                                },
                                {
                                    "note": "Ein Exemplar in der grünen Umstanzung kann nicht älter sein als das System, für das es gestanzt ist. Phillips 2016, S. 21 und S. 121, setzt die Produktion der grünen Rollen in die frühen zwanziger Jahre, nennt dafür aber keine Quelle. Die Grenze wird deshalb nur als wahrscheinlich geführt.",
                                    "premises": [],
                                    "applies": [
                                        "rules#system-terminus",
                                        "rules#weakest-premise"
                                    ],
                                    "@type": "inference"
                                }
                            ],
