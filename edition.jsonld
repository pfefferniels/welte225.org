        {
            "measurements": {},
            "conditions": [],
            "keeper": {
                "name": "Philippe Gourlin",
                "sameAs": [],
                "@annotation": {
                    "belief": {
                        "certainty": "possible",
                        "reasons": [
                            {
                                "note": "Die Sammlung nennen allein die Metadaten der emulierten MIDI-Datei, zusammen mit dem Scandatum. Anderweitig ist beides nicht zu belegen, und Warren Trachtman, der die Rolle 2007 gescannt hat, starb 2017.",
                                "@type": "beliefAdoption"
                            }
                        ],
                        "@type": "belief",
                        "@id": "8b4a1d58-799c-4b9c-9ab1-7251205a3b5f"
                    },
                    "@id": "44b6e632-5634-4fe1-9b79-af22fc16b9ae"
                }
            },
            "production": {
                "date": {
                    "after": "1916-01-01",
                    "@annotation": {
                        "belief": {
                            "certainty": "true",
                            "reasons": [
                                {
                                    "actor": {
                                        "name": "Phillips, Peter",
                                        "sameAs": []
                                    },
                                    "note": "Das Werk in Poughkeepsie räumte der Auto Pneumatic Action Company 1916 die Rechte an den Welte-Mignon-Patenten ein, um das Licensee-Instrument zu entwickeln. Die Rollen dafür entstanden von da an in Poughkeepsie aus den vorhandenen Welte-Mignon-Matrizen (Phillips 2016, S. 19 f.).",
                                    "@type": "beliefAdoption"
                                },
                                {
                                    "note": "Eine Licensee-Umstanzung kann nicht älter sein als die Rechte, aus denen sie hervorgeht. Die untere Grenze ist damit das Jahr 1916.",
                                    "premises": [],
                                    "applies": [
                                        "rules#system-terminus"
                                    ],
                                    "@type": "inference"
                                }
                            ],
                            "@type": "belief",
                            "@id": "d0addc91-2da2-436a-96e0-7c54dbc73ec2"
                        },
                        "@id": "421af45e-e395-42a8-a9eb-ffd195fedc46"
                    }
                },
                "system": {
                    "@id": "https://w3id.org/reo/type/system/welte-licensee"
                }
            },
            "readFrom": {
                "kind": "emulation",
                "actor": {
                    "name": "Trachtman, Warren",
                    "sameAs": []
                },
                "device": {
                    "name": "MK4 with capstan transport",
                    "sameAs": []
                },
                "date": {
                    "within": "2007-03-12",
                    "@annotation": {
                        "belief": {
                            "certainty": "likely",
                            "reasons": [
                                {
                                    "note": "Der Kopf der MIDI-Datei nennt den 12. März 2007 als Tag des Scans.",
                                    "@type": "beliefAdoption"
