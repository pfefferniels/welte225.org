                    ],
                    "editType": "additional-accent",
                    "motivation": "crescendo-onset-moved",
                    "@annotation": {
                        "belief": {
                            "certainty": "likely",
                            "reasons": [
                                {
                                    "note": "Das {{symbol_058f3b2f-6f66-4754-9e71-b4c858187e1f|zweite An}} des Crescendos im Bass trägt allein St1; es steht zwischen dem {{symbol_9d2ed841-8f5e-4c58-bfbb-258d930302f4|An}} und dem {{symbol_9618ebdc-40ae-4469-8fcf-473ee6d2965b|Ab}} und ist dort wirkungslos. Ein An nach einem An ist die Spur einer Verlegung: das An stand zuerst an der {{symbol_058f3b2f-6f66-4754-9e71-b4c858187e1f|späteren}} Stelle und wurde auf die {{symbol_9d2ed841-8f5e-4c58-bfbb-258d930302f4|frühere}} vorgezogen, die alte Stanzung blieb stehen; {{bab25aef-f80d-4ff0-b187-63030df8305a}} tilgt sie. Das Loch misst auf St1 7,2 mm gegen im Median 5,1 mm bei den Crescendo-Löchern im Bass, was eine eigene Stanzung dieses Exemplars nicht ausschließt.",
                                    "premises": [],
                                    "applies": [
                                        "rules#explain-redundancy"
                                    ],
                                    "@type": "inference"
                                }
                            ],
                            "@type": "belief",
                            "@id": "bccf373d-fdd8-44fc-9aba-1bc4ef4e8211"
                        },
                        "@id": "ff55399b-416f-480a-b582-d011c423bef6"
                    },
