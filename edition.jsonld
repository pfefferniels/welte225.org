                    "delete": [
                        "symbol_f92337d1-9462-4563-9418-a2d3a94e5dc8",
                        "symbol_dfcdb248-71a9-472e-81f9-de2e09afa35c"
                    ],
                    "@annotation": {
                        "belief": {
                            "certainty": "likely",
                            "reasons": [
                                {
                                    "note": "Die rasch wechselnden Stanzungen des Una Corda-Pedals in T. 9 trägt allein Wi1. Kein Exemplar zeigt hier eine Redundanz, die sie erklären müsste, und spätere Fassungen fügen in der Regel Nuancen hinzu; sie gelten daher als Hinzufügung dieser Fassung, die dafür Beginn und Ende der schlichten Aufhebung aus {{0e5f443d-0dd9-4810-9dbe-7f5007df490f}} verlegt.\n\nDenkbar bleibt, dass sie schon in {{0e5f443d-0dd9-4810-9dbe-7f5007df490f}} standen und {{19fd4209-81cc-4d03-b2c3-fc7518dbba14}} sie tilgte, etwa weil der schnelle Wechsel störende Geräusche verursachte; dann nähme {{19fd4209-81cc-4d03-b2c3-fc7518dbba14}} vier wirksame Stanzungen zurück und verlegte zwei.",
                                    "premises": [],
                                    "applies": [
                                        "rules#refinement",
                                        "rules#explain-redundancy"
                                    ],
                                    "@type": "inference"
                                }
                            ],
                            "@type": "belief",
                            "@id": "cd059f3f-2bec-4b84-bab0-bc5ec0a6da5e"
                        },
                        "@id": "28c23410-7759-4f9e-89b6-ffc9333d90fb"
                    },
