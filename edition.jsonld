                    "features": [
                        {
                            "method": "Print",
                            "transcription": {
                                "text": "Das Recht der Vervielfältigung\nist uns von den Künstlern aus-\ndrücklich übertragen. Jede\nanderweitige Vervielfältigung ist\nuntersagt und wird nach den\ngesetz. Bestimmungen verfolgt.\nM. WELTE & SÖHNE\nFreiburg i. Br.",
                                "@type": "text",
                                "@id": "b0100bc8-5fcd-479b-bdf2-765da43ea5e1"
                            },
