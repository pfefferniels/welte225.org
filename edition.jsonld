                {
                    "motivation": "pedal-held-through",
                    "delete": [
                        "symbol_321fbdb3-85db-4c44-8f72-0019d9c619b3"
                    ],
                    "@annotation": {
                        "belief": {
                            "certainty": "likely",
                            "reasons": [
                                {
                                    "note": "Das {{symbol_321fbdb3-85db-4c44-8f72-0019d9c619b3|Loslassen des Dämpferpedals}} fehlt allein auf Wi1; es steht auf St1, St2, Ch1 und Ne1, und Bo1 hält das Pedal genau bis dorthin. Wäre es eine Hinzufügung von {{19fd4209-81cc-4d03-b2c3-fc7518dbba14}}, machte diese eine in {{0e5f443d-0dd9-4810-9dbe-7f5007df490f}} bereits stehende Redundanz sinnvoll, was Bearbeitungen nicht tun. Also steht es in {{0e5f443d-0dd9-4810-9dbe-7f5007df490f}}, und dieses Exemplar hat es verloren.",
                                    "premises": [],
                                    "applies": [
                                        "rules#explain-redundancy"
                                    ],
