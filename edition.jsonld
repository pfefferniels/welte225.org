                            "n": 427,
                            "@annotation": {
                                "belief": {
                                    "certainty": "possible",
                                    "reasons": [
                                        {
                                            "note": "Median over 427 held notes of the pitch each keeps from its first inner slot to its last, read to a fraction of a pixel from roll-image-parser's slots (punch-225/settings225.py); interquartile spread 0.155 mm. The route gives 3.003 and 2.999 mm on St1 and St2, where the images give 3.001 and 2.999. The spread is ten times that of the other copies, so the scan's transport enters the value.",
                                            "used": [
                                                "/facsimiles/WR0225_02"
                                            ],
                                            "@type": "measurement"
                                        }
                                    ],
                                    "@type": "belief",
                                    "@id": "435efaf8-6294-4d55-b29d-f4351f83b127"
                                },
                                "@id": "8c8b8795-1977-4757-9846-d04946c00cc2"
                            }
