                {
                    "motivation": "una-corda-dropped",
                    "delete": [
                        "symbol_f92337d1-9462-4563-9418-a2d3a94e5dc8"
                    ],
                    "@annotation": {
                        "belief": {
                            "certainty": "likely",
                            "reasons": [
                                {
                                    "note": "Die Lesung zeigt keine Ab-Stanzung des Una Corda-Pedals, obwohl der Schalter von Spur 7 in der Löschreihe und nach dem letzten Ton anspricht. Das An auf Spur 8 kommt in der ganzen Datei nicht vor; ob Phillips’ Leser diese Spur liest, ist nicht bekannt, daher bleibt das Entfallen der An-Stanzungen offen. Die Anschlagstärken in Trachtmans Emulation von Gourlins Exemplar (Go1) (Go1) (Go1) (Go1) (Go1) (Go1) zeigen in T. 8′ bis 15 keine Änderung durch das Una Corda-Pedal.",
                                    "@type": "simpleArgumentation"
                                }
                            ],
                            "@type": "belief",
                            "@id": "dbbd3dae-c1ba-4363-83e8-0bceebd0ec78"
                        },
