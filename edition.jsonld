                        "advance": {
                            "value": 1.02,
                            "unit": "mm",
                            "strength": 0.2142,
                            "n": 10448,
                            "@annotation": {
                                "belief": {
                                    "certainty": "possible",
                                    "reasons": [
                                        {
                                            "note": "The strongest period the 10448 slot lengths keep, by condon-dates/perforator/advance.py (punch-225/settings225.py); runners-up 0.425 mm at 0.1147, 0.528 mm at 0.1303, 0.692 mm at 0.168. The chain pitch is 2.978 of it. Held likely when found at a strength of at least 0.35 with the pitch within 0.15 of a whole number of it, possible when one of the two holds, unlikely when neither does.",
                                            "used": [
                                                "/facsimiles/WR0225_02"
                                            ],
                                            "@type": "measurement"
                                        },
                                        {
                                            "note": "Das Datum 28. Oktober 1910 spricht dagegen, dass dies der Vorschub der Maschine ist. Spätestens am 1. Februar 1910 war der Vorschub halbiert (welte-premises, advance-1mm), und ein Vorschub von 1,00 mm ist an keiner später datierten Stanford-Kopie belegt.",
                                            "premises": [
                                                "b8dffe69-90ad-4d55-9196-2453ebcfc0d0",
