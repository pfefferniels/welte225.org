                "perforator": {
                    "drive": {
                        "@annotation": {
                            "belief": {
                                "certainty": "likely",
                                "reasons": [
                                    {
                                        "note": "The punch rows of chains held at the same time lie in line across the tracks. They are read from the interiors of chains, which carry the machine's firing rows and none of the pianist's timing, over 149 pairs of tracks: the offset between two tracks runs at 0.62 um per mm across the roll, which is the roll's tilt in the scanner, and what is left per track once that tilt is taken out is 74 um rms, against a noise of about 33 um and a scan line of 71 um. Phillips (2016, pp. 112 f.) reads rows in line as the mark of one ram head driving all the punches and staggered rows as the mark of a driver per punch. What is left are hundredths of a millimetre, 17 per cent of this copy's advance of 0.434 mm, and is as likely the mounting of the punches as anything in the drive. A stagger under about one scan line would not show.",
                                        "premises": [],
                                        "used": [
                                            "/facsimiles/WelteT98_225"
                                        ],
                                        "applies": [
                                            "rules#aligned-rows"
                                        ],
                                        "@type": "inference"
