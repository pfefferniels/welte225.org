+  for (i = 0; (i < Tube::NUM_SECTIONS) && (same); i++)
+  {
+    if ((i == Tube::LOWER_GLOTTIS_SECTION) || (i == Tube::UPPER_GLOTTIS_SECTION)) { continue; }
+    const TubeSection *ts = &tubeSection[i];
+    const bool perSlot = (i >= FIRST_STATIC_SLOT_SECTION) && (i < FIRST_STATIC_SLOT_SECTION + NUM_STATIC_SLOT_SECTIONS);
+    const double key[6] = { ts->area, ts->length, ts->volume, ts->Mw, ts->Bw, ts->Kw };
+    if (perSlot)
+    {
+      same = sameBits(&key[3], &staticReference[i][3], 2);
+    }
+    else
+    {
+      same = sameBits(key, staticReference[i], 6);
+    }
+    if (ts->articulator != staticReferenceArticulator[i]) { same = false; }
+  }
+
+  if (same == false)
+  {
+    // The first slot recorded (or, should the caller not have kept its word, or the options
+    // have changed: a new beginning).
+    invalidateStaticSlots();
+    staticReferenceTimeStep = timeStep;
+    staticReferenceSoftWalls = options.softWalls;
+    staticReferenceNoiseSources = options.generateNoiseSources;
+    for (i = 0; i < Tube::NUM_SECTIONS; i++)
+    {
+      const TubeSection *ts = &tubeSection[i];
+      const double key[6] = { ts->area, ts->length, ts->volume, ts->Mw, ts->Bw, ts->Kw };
+      for (k = 0; k < 6; k++) { staticReference[i][k] = key[k]; }
+      staticReferenceArticulator[i] = ts->articulator;
+    }
+    staticReferenceValid = true;
+  }
+
+  return true;
+}
