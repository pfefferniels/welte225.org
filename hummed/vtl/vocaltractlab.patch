+#ifdef TDS_REORDERED_SOLVER
+
+// ****************************************************************************
+/// Speed (almost the same results, not to the bit; only with
+/// TDS_REORDERED_SOLVER): the order in which solveEquationsReordered()
+/// eliminates the currents, and where the entries of the factorization are.
+///
+/// solveEquationsCholesky() eliminates the currents in the order of their
+/// numbers, so that every step waits for the one before, from the trachea to
+/// the nostrils and back. Here they are eliminated in rounds: in each round
+/// currents that have at most two neighbours left (or the fewest there are) and
+/// are no neighbours of each other, e.g. every other one along a row of tube
+/// sections. The currents of a round do not depend on each other, and a few
+/// rounds (8 for the network as it is) take the place of a chain as long as the
+/// network.
+// ****************************************************************************
+
+void TdsModel::initReorderedSolver()
+{
+  const int N = NUM_BRANCH_CURRENTS;
+  static bool adjacent[N][N];
+  static int neighbours[N][N];
+  int numNeighbours[N];
+  int place[N];
+  bool eliminated[N];
+  bool blocked[N];
+  int degree[N];
+  int i, j, e, u, v;
+  int count = 0;
+
+  reorderedPossible = true;
+
+  // The currents with a common entry of the matrix (see matrixEntryIndex).
+  for (i = 0; i < N; i++)
+  {
+    eliminated[i] = false;
+    for (j = 0; j < N; j++) { adjacent[i][j] = false; }
+  }
+  for (e = 0; e < numMatrixEntries; e++)
+  {
+    i = matrixEntryIndex[e] / N;
+    j = matrixEntryIndex[e] % N;
+    if (i != j) { adjacent[i][j] = adjacent[j][i] = true; }
+  }
+
+  while (count < N)
+  {
+    int limit = N;
+    for (i = 0; i < N; i++)
+    {
+      degree[i] = 0;
+      blocked[i] = false;
+      if (eliminated[i]) { continue; }
+      for (j = 0; j < N; j++) { if (adjacent[i][j]) { degree[i]++; } }
+      if (degree[i] < limit) { limit = degree[i]; }
+    }
+    if (limit < 2) { limit = 2; }
+
+    // The currents of this round ...
+    const int firstOfRound = count;
+    for (i = 0; i < N; i++)
+    {
+      if (eliminated[i] || blocked[i] || (degree[i] > limit)) { continue; }
+      reorderedCurrent[count] = i;
+      place[i] = count;
+      count++;
+      blocked[i] = true;
+      for (j = 0; j < N; j++) { if (adjacent[i][j]) { blocked[j] = true; } }
+    }
+
+    // ... and their elimination: their neighbours become neighbours of each other.
+    for (e = firstOfRound; e < count; e++)
+    {
+      i = reorderedCurrent[e];
+      numNeighbours[e] = 0;
+      for (j = 0; j < N; j++) { if (adjacent[i][j]) { neighbours[e][numNeighbours[e]++] = j; } }
+      for (u = 0; u < numNeighbours[e]; u++)
+      {
+        adjacent[i][neighbours[e][u]] = adjacent[neighbours[e][u]][i] = false;
+        for (v = 0; v < u; v++)
+        {
+          adjacent[neighbours[e][u]][neighbours[e][v]] = adjacent[neighbours[e][v]][neighbours[e][u]] = true;
+        }
+      }
+      eliminated[i] = true;
+    }
+  }
+
+  // Per column of the factorization (a place in the order) the rows with entries: the places
+  // of the neighbours at the time of the elimination, ascending.
+  for (e = 0; e < N; e++)
+  {
+    reorderedNumRows[e] = 0;
+    if (numNeighbours[e] > MAX_REORDERED_ROWS)
+    {
+      reorderedPossible = false;
+      continue;
+    }
+    for (u = 0; u < numNeighbours[e]; u++)
+    {
+      const int row = place[neighbours[e][u]];
+      for (v = reorderedNumRows[e]; (v > 0) && (reorderedRows[e][v - 1] > row); v--) { reorderedRows[e][v] = reorderedRows[e][v - 1]; }
+      reorderedRows[e][v] = row;
+      reorderedNumRows[e]++;
+    }
+    reorderedInverse[e] = 0.0;
+    reorderedSolution[e] = 0.0;
+    for (u = 0; u < MAX_REORDERED_ROWS; u++) { reorderedFactor[e][u] = 0.0; }
+    for (j = 0; j < N; j++) { reorderedPending[e][j] = 0.0; }
+  }
+
+  // Where the entries of the matrix go: into the lower triangle in the new order.
+  for (e = 0; e < numMatrixEntries; e++)
+  {
+    i = place[matrixEntryIndex[e] / N];
+    j = place[matrixEntryIndex[e] % N];
+    reorderedEntryTarget[e] = (i > j) ? (i * N + j) : (j * N + i);
+  }
+}
+
+
+// ****************************************************************************
+/// Speed (almost the same results, not to the bit; only with
+/// TDS_REORDERED_SOLVER): solves the system of equations like
+/// solveEquationsCholesky(), with the currents eliminated in the order of
+/// initReorderedSolver(), as a factorization L*D*L' (no square roots, one
+/// division per current). The solution differs from that of
+/// solveEquationsCholesky() by rounding errors.
+// ****************************************************************************
+
+void TdsModel::solveEquationsReordered()
+{
+  const int N = NUM_BRANCH_CURRENTS;
+  const double *M = &matrix[0][0];
+  double *pending = &reorderedPending[0][0];
+  double *s = reorderedSolution;
+  int p, e, a, b;
+
+  // The negated matrix and right-hand side vector (as in solveEquationsCholesky()), in the
+  // new order. The entries of the factorization that are no entries of the matrix are 0
+  // again since they were last used.
+  for (e = 0; e < numMatrixEntries; e++) { pending[reorderedEntryTarget[e]] = -M[matrixEntryIndex[e]]; }
+  for (p = 0; p < N; p++) { s[p] = -solutionVector[reorderedCurrent[p]]; }
+
+  // Factorization and forward substitution, column by column.
+  for (p = 0; p < N; p++)
+  {
+    const double pivot = reorderedPending[p][p];
+    if (!(pivot > 0)) printf("Error: Cholesky factorization: Matrix is not positive definite!\n");
+    const double inverse = 1.0 / pivot;
+    reorderedInverse[p] = inverse;
+    const double value = s[p];
+    const int m = reorderedNumRows[p];
+    const int *rows = reorderedRows[p];
+    double *l = reorderedFactor[p];
+
+    if (m == 2)
+    {
+      double *P0 = reorderedPending[rows[0]];
+      double *P1 = reorderedPending[rows[1]];
+      const double t0 = P0[p];
+      const double t1 = P1[p];
+      const double l0 = t0 * inverse;
+      const double l1 = t1 * inverse;
+      P0[p] = 0.0;
+      P1[p] = 0.0;
+      l[0] = l0;
+      l[1] = l1;
+      P0[rows[0]] -= l0 * t0;
+      P1[rows[0]] -= l1 * t0;
+      P1[rows[1]] -= l1 * t1;
+      s[rows[0]] -= l0 * value;
+      s[rows[1]] -= l1 * value;
+    }
+    else if (m == 1)
+    {
+      double *P0 = reorderedPending[rows[0]];
+      const double t0 = P0[p];
+      const double l0 = t0 * inverse;
+      P0[p] = 0.0;
+      l[0] = l0;
+      P0[rows[0]] -= l0 * t0;
+      s[rows[0]] -= l0 * value;
+    }
+    else
+    {
+      double t[MAX_REORDERED_ROWS];
+      for (a = 0; a < m; a++)
+      {
+        double *Pa = reorderedPending[rows[a]];
+        t[a] = Pa[p];
+        Pa[p] = 0.0;
+        l[a] = t[a] * inverse;
+        for (b = 0; b <= a; b++) { Pa[rows[b]] -= l[a] * t[b]; }
+        s[rows[a]] -= l[a] * value;
+      }
+    }
+  }
+
+  // Backward substitution.
+  for (p = N - 1; p >= 0; p--)
+  {
+    const int m = reorderedNumRows[p];
+    const int *rows = reorderedRows[p];
+    const double *l = reorderedFactor[p];
+    double value = s[p] * reorderedInverse[p];
+    for (a = 0; a < m; a++) { value -= l[a] * s[rows[a]]; }
+    s[p] = value;
+    flowVector[reorderedCurrent[p]] = value;
+  }
+}
+
+#endif
