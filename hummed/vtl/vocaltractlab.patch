+// Speed (same results): whether runs of doubles are the same to the bit (unlike ==, which
+// takes 0 and -0 for the same and NaN for different from itself), inline where memcmp is
+// a call (in WebAssembly).
+static inline bool sameBits(const double *a, const double *b, int count)
+{
+  for (int i = 0; i < count; i++)
+  {
+    uint64_t x, y;
+    memcpy(&x, &a[i], sizeof(x));
+    memcpy(&y, &b[i], sizeof(y));
+    if (x != y) { return false; }
+  }
+  return true;
+}
