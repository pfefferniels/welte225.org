+
+// ****************************************************************************
+// Speed (same results): see XmlNode.h. The digits make an integer of at most
+// 2^53, which a double holds exactly, as it holds the powers of ten up to
+// 10^22; their quotient, one division, is rounded to the nearest double of the
+// number written, which is the double that strtod() returns.
+// ****************************************************************************
+
+bool xmlPlainDecimalToDouble(const char *st, double &value)
+{
+  static const double POWER_OF_TEN[23] =
+  {
+    1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
+    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22
+  };
+  const char *p = st;
+  bool negative = false;
+  bool inFraction = false;
+  uint64_t digits = 0;
+  int numDigits = 0;
+  int numFractionDigits = 0;
+
+  if (*p == '-')
+  {
+    negative = true;
+    p++;
+  }
+
+  for (; *p != '\0'; p++)
+  {
+    if ((*p >= '0') && (*p <= '9'))
+    {
+      if (numDigits >= 18) { return false; }
+      digits = digits*10 + (uint64_t)(*p - '0');
+      numDigits++;
+      if (inFraction) { numFractionDigits++; }
+    }
+    else
+    if ((*p == '.') && (inFraction == false))
+    {
+      inFraction = true;
+    }
+    else
+    {
+      return false;
+    }
+  }
+
+  if ((numDigits == 0) || (digits > 9007199254740992ULL) || (numFractionDigits > 22))
+  {
+    return false;
+  }
+
+  double d = (double)digits;
+  if (numFractionDigits > 0)
+  {
+    d = d / POWER_OF_TEN[numFractionDigits];
+  }
+  value = negative ? -d : d;
+  return true;
+}
 
 
