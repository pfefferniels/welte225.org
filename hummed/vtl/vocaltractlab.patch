+bool Surface::getTriangleList(int *indexList, int &numEntries, int MAX_ENTRIES)
+{
+  int count = 0;
+
+  bool ok = walkTiles([&](const Tile *t)
+  {
+    int i;
+    const int *source;
+    if (count + t->numTriangles > MAX_ENTRIES) { return false; }
+    source = &t->triangle[0];
+    for (i=t->numTriangles-1; i >= 0; i--) { *indexList++ = *source++; }
+    count+= t->numTriangles;
+    return true;
+  });
+
+  numEntries = count;
+  return ok;
+}
+
+// ****************************************************************************
+/// @brief Speed (same results): getTriangleList() with every triangle named
+/// once, at its first place in that list.
+///
+/// \a numEntriesWithRepeats returns the number of entries in the list of
+/// getTriangleList(), which is also what is held against \a MAX_ENTRIES.
+/// The triangles are marked as visited (see visitTriangle()).
+// ****************************************************************************
+
+bool Surface::getTriangleListOnce(int *indexList, int &numEntries, int &numEntriesWithRepeats, int MAX_ENTRIES)
+{
+  int count = 0;
+  int countWithRepeats = 0;
+  const unsigned int stamp = lineStamp;
+  unsigned int *mark = triangleMark;
+
+  bool ok = walkTiles([&](const Tile *t)
+  {
+    int i;
+    const int *source;
+    if (countWithRepeats + t->numTriangles > MAX_ENTRIES) { return false; }
+    source = &t->triangle[0];
+    for (i=t->numTriangles-1; i >= 0; i--)
+    {
+      const int index = *source++;
+      if (mark[index] != stamp)
+      {
+        mark[index] = stamp;
+        indexList[count++] = index;
+      }
+    }
+    countWithRepeats+= t->numTriangles;
+    return true;
+  });
+
+  numEntries = count;
+  numEntriesWithRepeats = countWithRepeats;
+  return ok;
+}
