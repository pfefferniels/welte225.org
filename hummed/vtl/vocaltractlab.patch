+// ****************************************************************************
+
+bool TdsModel::canReplayStaticSlot(int run, int slot)
+{
+  if ((run == 0) || (run != staticRun) || (slot < 0) || (slot >= staticNumSlots))
+  {
+    return false;
+  }
+  const StaticSlot &s = staticSlots[slot];
+  const int slotBefore = (slot == 0) ? staticNumSlots - 1 : slot - 1;
+  return (s.recorded) && (s.chained) && (lastStaticSlot == slotBefore) &&
+    (staticReferenceValid) && (sameBits(&timeStep, &staticReferenceTimeStep, 1)) &&
+    (options.softWalls == staticReferenceSoftWalls) &&
+    (options.generateNoiseSources == staticReferenceNoiseSources);
