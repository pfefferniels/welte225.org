+// ****************************************************************************
+/// solveEquationsCholesky() for envelopes that are contiguous ranges, with the
+/// same results to the bit: the same arithmetic operations in the same order,
+/// with simpler bookkeeping of the indices, without the products with the zeros
+/// left of a row's envelope (which change no result), and without factorizing
+/// anew the leading rows that have not changed since the previous time step.
+// ****************************************************************************
+
+void TdsModel::solveEquationsCholeskyContiguous()
+{
+  int k, i, j, u;
+
+  // The leading rows whose entries equal those of the previous time step have the same
+  // factorization as then, which is still in factorizationMatrix (the trachea's rows, while
+  // the glottis and the tract above it change). The first row that differs is kept for the
+  // next time step, so that previousMatrix holds this time step's rows up to it.
+  int reused = 0;
+  while ((reused < previousMatrixRows) && sameBits(&previousMatrix[reused][envelopeFirstColumn[reused]],
+    &matrix[reused][envelopeFirstColumn[reused]], reused - envelopeFirstColumn[reused] + 1))
+  {
+    reused++;
+  }
+  if (reused < NUM_BRANCH_CURRENTS)
+  {
+    for (j = envelopeFirstColumn[reused]; j <= reused; j++) { previousMatrix[reused][j] = matrix[reused][j]; }
+    previousMatrixRows = reused + 1;
+  }
+
+  // Negate the matrix (the rows not reused) and the right-hand side vector.
+  for (i = reused; i < NUM_BRANCH_CURRENTS; i++)
+  {
+    double *F = factorizationMatrix[i];
+    const double *M = matrix[i];
+    F[i] = -M[i];
+    for (j = envelopeFirstColumn[i]; j < i; j++) { F[j] = -M[j]; }
+  }
+  for (i = 0; i < NUM_BRANCH_CURRENTS; i++) { solutionVector[i] = -solutionVector[i]; }
+
+  // Cholesky factorization, and the forward substitution of each row as soon as the row is
+  // factorized (the same operations as one after the other, but the two chains of dependent
+  // operations can overlap).
+  for (k = 0; k < NUM_BRANCH_CURRENTS; k++)
+  {
+    double *Fk = factorizationMatrix[k];
+    const int first = envelopeFirstColumn[k];
+    if (k >= reused)
+    {
+      double diagonal = Fk[k];
+      for (j = first; j < k; j++) { diagonal -= Fk[j] * Fk[j]; }
+      if (diagonal < 0) printf("Error: Cholesky factorization: Matrix is not positive definite!\n");
+      Fk[k] = sqrt(diagonal);
+    }
+    const double diagonal = Fk[k];
+
+    for (u = 0; u < numFilledColumnValuesSymmetricEnvelope[k]; u++)
+    {
+      const int row = filledColumnIndexSymmetricEnvelope[k][u];
+      if (row < reused) { continue; }
+      double *Fi = factorizationMatrix[row];
+      double value = Fi[k];
+      // the entries left of row i's envelope are zero, and so are their products
+      const int start = envelopeFirstColumn[row] > first ? envelopeFirstColumn[row] : first;
+      for (j = start; j < k; j++) { value -= Fi[j] * Fk[j]; }
+      Fi[k] = value / diagonal;
+    }
+
+    double value = solutionVector[k];
+    for (j = first; j < k; j++) { value -= Fk[j] * solutionVector[j]; }
+    solutionVector[k] = value / diagonal;
+  }
+
+  // backward substitution
+  for (k = NUM_BRANCH_CURRENTS - 1; k >= 0; --k)
+  {
+    double value = solutionVector[k];
+    for (u = 0; u < numFilledColumnValuesSymmetricEnvelope[k]; u++)
+    {
+      i = filledColumnIndexSymmetricEnvelope[k][u];
+      value -= factorizationMatrix[i][k] * flowVector[i];
+    }
+    solutionVector[k] = value;
+    flowVector[k] = value / factorizationMatrix[k][k];
+  }
+}
