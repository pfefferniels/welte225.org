+
+bool TdsModel::checkStaticReference()
+{
+  int i, k;
+
+  if (staticUnclipped == false)
+  {
+    return false;
+  }
+
+  bool same = (staticReferenceValid) && (sameBits(&timeStep, &staticReferenceTimeStep, 1)) &&
+    (options.softWalls == staticReferenceSoftWalls) &&
+    (options.generateNoiseSources == staticReferenceNoiseSources);
