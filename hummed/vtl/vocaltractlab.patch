+// ****************************************************************************
+// Added for the browser build: a gestural score file -> the vocal tract and
+// glottis states every 110 samples, written into caller memory (stride: the
+// number of tract / glottis parameters), so that a caller can synthesize them
+// incrementally with vtlSynthesisAddTube() or vtlSynthesisAddTract().
+// Returns 0 on success, 1 not initialized, 2 load failed, 3 out of range.
+// ****************************************************************************
+
+extern "C" int vtlGesturalScoreToStates(const char* gesFileName, double* tractParams,
+  double* glottisParams, int maxStates, int* numStates)
+{
+  if (!vtlApiInitialized) return 1;
+  GesturalScore* gs = new GesturalScore(vocalTract, glottis[selectedGlottis]);
+  bool inRange = true;
+  if (gs->loadGesturesXml(string(gesFileName), inRange) == false) { delete gs; return 2; }
+  if (inRange == false) { delete gs; return 3; }
+  gs->calcCurves();
+  int n = (int)(gs->getDuration_pt() / Synthesizer::NUM_CHUNCK_SAMPLES) + 2;
+  if (n > maxStates) n = maxStates;
+  int nG = (int)glottis[selectedGlottis]->controlParam.size();
+  double g[Glottis::MAX_CONTROL_PARAMS];
+  for (int i = 0; i < n; i++)
+  {
+    double pos_s = (double)i * Synthesizer::NUM_CHUNCK_SAMPLES / SAMPLING_RATE;
+    gs->getParams(pos_s, tractParams + i * VocalTract::NUM_PARAMS, g);
+    for (int k = 0; k < nG; k++) glottisParams[i * nG + k] = g[k];
+  }
+  *numStates = n;
+  delete gs;
+  return 0;
+}
