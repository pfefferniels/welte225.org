+    if (k >= reused)
+    {
+      if (x < 0) printf("Error: Cholesky factorization: Matrix is not positive definite!\n");
+      d = sqrt(x);
+      choleskyDiagonal[k] = d;
+    }
+    else
+    {
+      d = choleskyDiagonal[k];
+    }
+
+    const int m = numFilledColumnValuesSymmetricEnvelope[k];
+    const int *rows = filledColumnIndexSymmetricEnvelope[k];
+    double *l = choleskyColumn[k];
+    if (k + 1 < N) { x = choleskyPending[k + 1][k + 1]; }
+
+    if ((m > 0) && (rows[0] == k + 1))
+    {
+      // The next row's entry and what it takes from the next diagonal entry stay in registers:
+      // the chain that the time depends on.
+      double *Pn = choleskyPending[k + 1];
+      const double l0 = Pn[k] / d;
+      Pn[k] = -0.0;
+      l[0] = l0;
+      x -= l0 * l0;
+      switch (m)
+      {
+#define X(M) case M: choleskyColumnRows<M>(choleskyPending, rows, l, k, d); break;
+        TDS_FOR_ROW_COUNTS(X)
+#undef X
+        default: break;
+      }
+    }
+    else
+    {
+      for (a = 0; a < m; a++)
+      {
+        double *Pa = choleskyPending[rows[a]];
+        const double la = Pa[k] / d;
+        Pa[k] = -0.0;
+        l[a] = la;
+        for (b = 0; b <= a; b++) { Pa[rows[b]] -= la * l[b]; }
+      }
+    }
+
+    if (k < caughtUp)
+    {
+      for (i = 2 * (k - firstColumn); i < 2 * (k - firstColumn) + 2; i++)
+      {
+        const double value = solutionVector[i] / choleskyDiagonal[i];
+        solutionVector[i] = value;
+        const int mi = numFilledColumnValuesSymmetricEnvelope[i];
+        const int *ri = filledColumnIndexSymmetricEnvelope[i];
+        const double *li = choleskyColumn[i];
+        for (a = 0; a < mi; a++) { solutionVector[ri[a]] -= li[a] * value; }
+      }
+    }
+    else
+    {
+      const double value = solutionVector[k] / d;
+      solutionVector[k] = value;
+      switch (m)
+      {
+        case 0: break;
+        case 1: choleskyForwardRows<1>(solutionVector, rows, l, value); break;
+#define X(M) case M: choleskyForwardRows<M>(solutionVector, rows, l, value); break;
+        TDS_FOR_ROW_COUNTS(X)
+#undef X
+        default: for (a = 0; a < m; a++) { solutionVector[rows[a]] -= l[a] * value; } break;
+      }
+    }
+
+    // the row for the column after the next one
+    if (wholeTimeStep)
+    {
+      const int row = k + 2;
+      if ((row >= numRows) && (row < N) && !matrixRowIsEarly[row]) { addRow(row); }
+    }
+  }
+  for (i = 2 * (N - firstColumn); i < N; i++)
+  {
+    const double value = solutionVector[i] / choleskyDiagonal[i];
+    solutionVector[i] = value;
+    const int mi = numFilledColumnValuesSymmetricEnvelope[i];
+    const int *ri = filledColumnIndexSymmetricEnvelope[i];
+    const double *li = choleskyColumn[i];
+    for (a = 0; a < mi; a++) { solutionVector[ri[a]] -= li[a] * value; }
+  }
+
+  // Backward substitution (the flow of the next row stays in a register), and for a whole
+  // time step the new currents and pressures as their flows come out: with the flow of
+  // current k all flows into and out of section k are known (see wholeTimeStepPossible). They
+  // are taken a few flows later, when the flows are in memory for good (two that are still on
+  // their way there cannot be read in one piece without waiting).
+  const int updateLag = 4;
+  const double noiseFilterCoeff = wholeTimeStep ? getNoiseFilterCoeff() : 0.0;
+  double flow = 0.0;
+  for (k = N - 1; k >= 0; --k)
+  {
+    const int m = numFilledColumnValuesSymmetricEnvelope[k];
+    const int *rows = filledColumnIndexSymmetricEnvelope[k];
+    const double *l = choleskyColumn[k];
+    double value = solutionVector[k];
+    a = 0;
+    if ((m > 0) && (rows[0] == k + 1))
+    {
+      value -= l[0] * flow;
+      a = 1;
+    }
+    for (; a < m; a++) { value -= l[a] * flowVector[rows[a]]; }
+    solutionVector[k] = value;
+    flow = value / choleskyDiagonal[k];
+    flowVector[k] = flow;
+
+    if (wholeTimeStep && (k + updateLag < N))
+    {
+      updateCurrentsFrom(k + updateLag, noiseFilterCoeff);
+      if (k + updateLag < Tube::NUM_SECTIONS) { updateSectionsFrom(k + updateLag); }
+    }
+  }
+  if (wholeTimeStep)
+  {
+    for (i = ((updateLag < N) ? updateLag : N) - 1; i >= 0; i--)
+    {
+      updateCurrentsFrom(i, noiseFilterCoeff);
+      if (i < Tube::NUM_SECTIONS) { updateSectionsFrom(i); }
+    }
+  }
+}
