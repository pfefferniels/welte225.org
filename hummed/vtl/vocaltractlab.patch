+// ****************************************************************************
+/// Speed (same results): whether all that interpolate() reads of a left or
+/// right tube is the same to the bit in the two tubes.
+// ****************************************************************************
+
+bool Tube::sameForInterpolation(const Tube &a, const Tube &b)
+{
+  int i;
+  const double valueA[8] = { a.teethPosition_cm, a.tongueTipSideElevation, a.rawVelumOpening_cm2,
+    a.aspirationStrength_dB, a.subglottalCavityLength_cm, a.nasalCavityLength_cm,
+    a.piriformFossaLength_cm, a.piriformFossaVolume_cm3 };
+  const double valueB[8] = { b.teethPosition_cm, b.tongueTipSideElevation, b.rawVelumOpening_cm2,
+    b.aspirationStrength_dB, b.subglottalCavityLength_cm, b.nasalCavityLength_cm,
+    b.piriformFossaLength_cm, b.piriformFossaVolume_cm3 };
+
+  if (memcmp(valueA, valueB, sizeof(valueA)) != 0)
+  {
+    return false;
+  }
+
+  for (i=0; i < NUM_PHARYNX_MOUTH_SECTIONS; i++)
+  {
+    const Section *sa = &a.pharynxMouthSection[i];
+    const Section *sb = &b.pharynxMouthSection[i];
+    if ((memcmp(&sa->area_cm2, &sb->area_cm2, sizeof(double)) != 0) ||
+        (memcmp(&sa->length_cm, &sb->length_cm, sizeof(double)) != 0) ||
+        (sa->articulator != sb->articulator))
+    {
+      return false;
+    }
+  }
+
+  return true;
+}
