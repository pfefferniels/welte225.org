+#endif
+
+#ifdef __wasm_simd128__
+// Speed (same results): two doubles from different places as the two lanes of a vector, for
+// operations on two independent values at a time (each lane's result is that of the operation
+// on its own). Not wasm_f64x2_make(*first, *second): Emscripten 3.1.6's compiler makes a
+// v128.load64_splat of that, which it may put after a later store to *first. The value after
+// *first is read as well and dropped. (Check a build for this with wasm-dis: it must have no
+// more v128.load64_splat than before.)
+static TDS_ALWAYS_INLINE v128_t loadPair(const double *first, const double *second)
+{
+  return wasm_f64x2_replace_lane(wasm_v128_load(first), 1, *second);
+}
+#endif
+
+// Speed (same results): the inner loops of choleskyTimeStep() for a column with M rows below
+// the diagonal. M is known where they are used (a switch over the numbers that occur), so the
+// loops have fixed lengths and no branches that the processor mispredicts.
+namespace
+{
+  typedef double CholeskyRow[TdsModel::NUM_BRANCH_CURRENTS];
+
+  // The entries of column k in its rows but the first, and their products subtracted from
+  // the entries to the right of the column in these rows.
+  template <int M> TDS_ALWAYS_INLINE void choleskyColumnRows(CholeskyRow *pending, const int *rows, double *l, int k, double d)
+  {
+    int a = 1;
+#ifdef __wasm_simd128__
+    // two quotients at a time (each is the same quotient as on its own)
+    const v128_t dd = wasm_f64x2_splat(d);
+    for (; a + 1 < M; a += 2)
+    {
+      double *Pa = pending[rows[a]];
+      double *Pb = pending[rows[a + 1]];
+      wasm_v128_store(&l[a], wasm_f64x2_div(loadPair(&Pa[k], &Pb[k]), dd));
+      Pa[k] = -0.0;
+      Pb[k] = -0.0;
+    }
+#endif
+    for (; a < M; a++)
+    {
+      double *Pa = pending[rows[a]];
+      l[a] = Pa[k] / d;
+      Pa[k] = -0.0;
+    }
+    for (a = 1; a < M; a++)
+    {
+      double *Pa = pending[rows[a]];
+      const double la = l[a];
+      for (int b = 0; b <= a; b++) { Pa[rows[b]] -= la * l[b]; }
+    }
+  }
+
+  // Forward substitution: the solved value of a column taken out of the rows below.
+  template <int M> TDS_ALWAYS_INLINE void choleskyForwardRows(double *solution, const int *rows, const double *l, double value)
+  {
+    for (int a = 0; a < M; a++) { solution[rows[a]] -= l[a] * value; }
+  }
+}
+
+#define TDS_FOR_ROW_COUNTS(X) X(2) X(3) X(4) X(5) X(6) X(7) X(8) X(9) X(10)
+
+// Speed (same results): the bodies of the two loops of updateVariables(), for one current and
+// for one section, and for two of each at a time: each lane of a vector is one current's or
+// one section's operations in their order (the divisions take most of the time here, and two
+// in a vector take as long as one).
+namespace
+{
+  TDS_ALWAYS_INLINE void updateCurrent(TdsModel::BranchCurrent *bc, const double flow, const double timeStep,
+    const double noiseFilterCoeff)
+  {
+    const double THETA = TdsModel::THETA;
+    const double THETA1 = TdsModel::THETA1;
+    const double oldCurrent = bc->magnitude;
+
+    bc->magnitude = flow;
+    bc->magnitudeRate = (bc->magnitude - oldCurrent)/(timeStep*THETA) - (THETA1/THETA)*bc->magnitudeRate;
+    bc->noiseMagnitude = (1.0-noiseFilterCoeff)*bc->magnitude + noiseFilterCoeff*bc->noiseMagnitude;
+  }
+
+  TDS_ALWAYS_INLINE void updateSection(TdsModel::TubeSection *ts, const double netFlow, const double timeStep)
+  {
+    const double THETA = TdsModel::THETA;
+    const double THETA1 = TdsModel::THETA1;
+    double oldPressure;
+    double oldCurrent;
+    double oldCurrentRate;
+
+    oldPressure = ts->pressure;
+    ts->pressure = ts->D + ts->E*netFlow;
+    ts->pressureRate = (ts->pressure - oldPressure)/(timeStep*THETA) - ts->pressureRate*(THETA1/THETA);
+
+    // The current "into the wall".
+
+    oldCurrent = ts->wallCurrent;
+    oldCurrentRate = ts->wallCurrentRate;
+    
+    ts->wallCurrent = ts->pressureRate*ts->alpha + ts->beta;
+    ts->wallCurrentRate  = (ts->wallCurrent - oldCurrent)/(timeStep*THETA) - oldCurrentRate*(THETA1/THETA);
+    ts->wallCurrentRate2 = (ts->wallCurrentRate - oldCurrentRate)/(timeStep*THETA) - ts->wallCurrentRate2*(THETA1/THETA);
+  }
+
+#ifdef __wasm_simd128__
+  // flow: the flows of the two currents, one after the other.
+  TDS_ALWAYS_INLINE void updateCurrentPair(TdsModel::BranchCurrent *bc0, TdsModel::BranchCurrent *bc1, const double *flow,
+    const double timeStep, const double noiseFilterCoeff)
+  {
+    const v128_t step2 = wasm_f64x2_splat(timeStep*TdsModel::THETA);
+    const v128_t thetaRatio2 = wasm_f64x2_splat(TdsModel::THETA1/TdsModel::THETA);
+    const v128_t filterCoeff2 = wasm_f64x2_splat(noiseFilterCoeff);
+    const v128_t filterCoeffRest2 = wasm_f64x2_splat(1.0-noiseFilterCoeff);
+
+    const v128_t old2 = loadPair(&bc0->magnitude, &bc1->magnitude);
+    const v128_t magnitude2 = wasm_v128_load(flow);
+    const v128_t rate2 = wasm_f64x2_sub(wasm_f64x2_div(wasm_f64x2_sub(magnitude2, old2), step2),
+      wasm_f64x2_mul(thetaRatio2, loadPair(&bc0->magnitudeRate, &bc1->magnitudeRate)));
+    const v128_t noise2 = wasm_f64x2_add(wasm_f64x2_mul(filterCoeffRest2, magnitude2),
+      wasm_f64x2_mul(filterCoeff2, loadPair(&bc0->noiseMagnitude, &bc1->noiseMagnitude)));
+
+    bc0->magnitude = wasm_f64x2_extract_lane(magnitude2, 0);
+    bc1->magnitude = wasm_f64x2_extract_lane(magnitude2, 1);
+    bc0->magnitudeRate = wasm_f64x2_extract_lane(rate2, 0);
+    bc1->magnitudeRate = wasm_f64x2_extract_lane(rate2, 1);
+    bc0->noiseMagnitude = wasm_f64x2_extract_lane(noise2, 0);
+    bc1->noiseMagnitude = wasm_f64x2_extract_lane(noise2, 1);
+  }
+
+  TDS_ALWAYS_INLINE void updateSectionPair(TdsModel::TubeSection *ts0, TdsModel::TubeSection *ts1, const double netFlow0,
+    const double netFlow1, const double timeStep)
+  {
+    const v128_t step2 = wasm_f64x2_splat(timeStep*TdsModel::THETA);
+    const v128_t thetaRatio2 = wasm_f64x2_splat(TdsModel::THETA1/TdsModel::THETA);
+
+    const v128_t oldPressure2 = loadPair(&ts0->pressure, &ts1->pressure);
+    const v128_t pressure2 = wasm_f64x2_add(loadPair(&ts0->D, &ts1->D),
+      wasm_f64x2_mul(loadPair(&ts0->E, &ts1->E), wasm_f64x2_make(netFlow0, netFlow1)));
+    const v128_t pressureRate2 = wasm_f64x2_sub(wasm_f64x2_div(wasm_f64x2_sub(pressure2, oldPressure2), step2),
+      wasm_f64x2_mul(loadPair(&ts0->pressureRate, &ts1->pressureRate), thetaRatio2));
+
+    const v128_t oldCurrent2 = loadPair(&ts0->wallCurrent, &ts1->wallCurrent);
+    const v128_t oldCurrentRate2 = loadPair(&ts0->wallCurrentRate, &ts1->wallCurrentRate);
+    const v128_t wallCurrent2 = wasm_f64x2_add(wasm_f64x2_mul(pressureRate2, loadPair(&ts0->alpha, &ts1->alpha)),
+      loadPair(&ts0->beta, &ts1->beta));
+    const v128_t wallCurrentRate2 = wasm_f64x2_sub(wasm_f64x2_div(wasm_f64x2_sub(wallCurrent2, oldCurrent2), step2),
+      wasm_f64x2_mul(oldCurrentRate2, thetaRatio2));
+    const v128_t wallCurrentRate22 = wasm_f64x2_sub(wasm_f64x2_div(wasm_f64x2_sub(wallCurrentRate2, oldCurrentRate2), step2),
+      wasm_f64x2_mul(loadPair(&ts0->wallCurrentRate2, &ts1->wallCurrentRate2), thetaRatio2));
+
+    ts0->pressure = wasm_f64x2_extract_lane(pressure2, 0);
+    ts1->pressure = wasm_f64x2_extract_lane(pressure2, 1);
+    ts0->pressureRate = wasm_f64x2_extract_lane(pressureRate2, 0);
+    ts1->pressureRate = wasm_f64x2_extract_lane(pressureRate2, 1);
+    ts0->wallCurrent = wasm_f64x2_extract_lane(wallCurrent2, 0);
+    ts1->wallCurrent = wasm_f64x2_extract_lane(wallCurrent2, 1);
+    ts0->wallCurrentRate = wasm_f64x2_extract_lane(wallCurrentRate2, 0);
+    ts1->wallCurrentRate = wasm_f64x2_extract_lane(wallCurrentRate2, 1);
+    ts0->wallCurrentRate2 = wasm_f64x2_extract_lane(wallCurrentRate22, 0);
+    ts1->wallCurrentRate2 = wasm_f64x2_extract_lane(wallCurrentRate22, 1);
+  }
+#endif
+}
