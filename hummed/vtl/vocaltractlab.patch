+// Speed (same results): the index of the lowest bit set in a word that is not zero.
+static inline int lowestBit(unsigned long long word)
+{
+#if defined(__GNUC__) || defined(__clang__)
+  return __builtin_ctzll(word);
+#else
+  int index = 0;
+  while ((word & 1ULL) == 0) { word >>= 1; index++; }
+  return index;
+#endif
+}
